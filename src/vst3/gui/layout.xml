<!-- JIVE XML LAYOUT -->
<!-- https://github.com/ImJimmi/JIVE -->

<Component width="620" height="520" padding="16" flex-direction="column">
    <Component height="28" flex-direction="row" align-items="stretch">
        <Text text="Device" width="56"/>
        <TextEditor id="device-editor" width="170"/>
        <Text text="Baud" width="48" margin="0 0 0 8"/>
        <ComboBox id="baud-box" width="90">
            <Option text="9600"/>
            <Option text="19200"/>
            <Option text="38400"/>
            <Option text="57600"/>
            <Option text="115200"/>
        </ComboBox>
    </Component>

    <Component height="28" margin="8 0 0 0" flex-direction="row">
        <Button id="connect-button" text="Connect" width="100"/>
        <Label id="status-label" flex-grow="1" margin="0 0 0 10"/>
    </Component>

    <Component height="28" margin="8 0 0 0" flex-direction="row">
        <Text text="Pin" width="32"/>
        <TextEditor id="pin-editor" width="70"/>
        <Text text="Type" width="48" margin="0 0 0 8"/>
        <ComboBox id="type-box" width="120" selected="1">
            <Option text="Remove"/>
            <Option text="Digital" selected="1"/>
            <Option text="Pullup"/>
            <Option text="Analog"/>
        </ComboBox>
        <Button id="send-button" text="Send" width="80" margin="0 0 0 8"/>
    </Component>

    <TextEditor id="mappings-view" height="110" margin="8 0 0 0"/>
    <TextEditor id="log-view" flex-grow="1" margin="8 0 0 0"/>
</Component>
