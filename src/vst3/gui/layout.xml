<!-- JIVE XML LAYOUT -->
<!-- https://github.com/ImJimmi/JIVE -->

<Component width="620" height="180" padding="8" flex-direction="column">
    <Component height="32" flex-direction="row" align-items="stretch">
        <Image id="image-logo" width="24" height="24" margin="4 0 4 0"/>
        <Component flex-grow="1"/>
        <TextEditor id="device-editor" width="190" focusable="1"/>
        <ComboBox id="baud-box" width="90" margin="0 0 0 8">
            <Option text="9600" enabled="1"/>
            <Option text="19200" enabled="1"/>
            <Option text="38400" enabled="1"/>
            <Option text="57600" enabled="1"/>
            <Option text="115200" enabled="1"/>
        </ComboBox>
        <Button id="connect-button" text="Connect" width="100" margin="0 0 0 8"/>
    </Component>

    <Component id="mapping-panel" height="120" margin="8 0 0 0" flex-direction="row" align-items="stretch">
        <MappingStrip id="mapping-strip" flex-grow="1"/>
        <Button id="new-map-button" text="+" width="32" margin="0 0 0 8"/>
    </Component>
</Component>
